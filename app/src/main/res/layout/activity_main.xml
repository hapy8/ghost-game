<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bottom"
    android:clipChildren="false">

    <com.ghostrun.game.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:shadowColor="@color/black"
                android:text="Score: 0" />
            <TextView
                android:id="@+id/bestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:shadowColor="@color/black"
                android:text="Best: 0" />
            <TextView
                android:id="@+id/comboText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/spooky_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:shadowColor="@color/black"
                android:visibility="gone"
                android:text="Combo x2" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/muteButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="VOL"
            android:textSize="12sp"
            app:cornerRadius="24dp"
            android:contentDescription="@string/action_mute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pauseButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="II"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            android:contentDescription="@string/action_pause" />
    </LinearLayout>

    <!-- Menu (scrollable for short landscape screens + cutouts) -->
    <ScrollView
        android:id="@+id/menuScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/menuOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="#CC0A0F24">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_logo_ghost"
                android:contentDescription="@string/desc_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_title"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="2"
                android:shadowColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_subtitle"
                android:textColor="@color/ghost"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/menuBestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Best: 0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/how_to_play"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="240dp"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="@string/action_start"
                android:textSize="20sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/licensesButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/action_licenses"
                android:textColor="@color/ghost" />
        </LinearLayout>
    </ScrollView>

    <!-- Pause -->
    <LinearLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#B3000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_paused"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resumeButton"
            android:layout_width="240dp"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="@string/action_resume"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pauseMenuButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="240dp"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="@string/action_menu"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Game over -->
    <ScrollView
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#D9000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_game_over"
                android:textColor="@color/spooky_red"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/finalScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:text="Final Score: 0" />

            <TextView
                android:id="@+id/newBestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_new_best"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gameOverStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ghost"
                android:textSize="14sp"
                android:gravity="center"
                android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restartButton"
                android:layout_width="240dp"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:text="@string/action_restart"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gameOverMenuButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="240dp"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="@string/action_menu"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
